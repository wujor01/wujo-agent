{
  "expo": {
    "name": "WujoAgent",
    "slug": "wujoagent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.wujo.wujoagent",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "WujoAgent connects to your computer on your local network or Tailscale to control Claude Code.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "WujoAgent uses the camera to scan the QR code that adds a computer."
      },
      "associatedDomains": [
        "applinks:agent.wujo.dev"
      ]
    },
    "android": {
      "package": "dev.wujo.wujoagent",
      "adaptiveIcon": {
        "backgroundColor": "#1B1A18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "agent.wujo.dev",
              "pathPrefix": "/add"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "WujoAgent uses the camera to scan the QR code that adds a computer.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B1A18"
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": true,
          "color": "#D97757"
        }
      ]
    ],
    "scheme": "wujoagent",
    "owner": "wujor01",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "8d12ebb9-7c8e-43b1-89e0-9ce46e54022f"
      }
    },
    "locales": {
      "vi": "./locales/vi.json"
    }
  }
}
