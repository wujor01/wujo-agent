// Trang giới thiệu WujoAgent (landing/) trên agent.wujo.dev: file tĩnh cùng một Worker nhỏ chọn
// ngôn ngữ và phục vụ các link tải (landing-worker.js).
// Triển khai: xem docs/release.md. Từ máy đã `wrangler login`:  npm run deploy   (trong thư mục này)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wujoagent-landing",
  "main": "landing-worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../landing",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Chỉ các trang HTML và link tải app đi qua Worker.
    "run_worker_first": [
      "/", "/privacy", "/changelog", "/en", "/en/", "/en/privacy", "/en/changelog", "/download/android", "/download/ios"
    ]
  },
  "vars": {
    // Bản APK hiện hành (EAS, profile "beta"). Sau mỗi lần build: dán link https://expo.dev/artifacts/eas/....apk
    // vào đây rồi deploy trong vòng 14 ngày, khi EAS còn giữ file; sync-apk.mjs chép nó sang bucket DOWNLOADS
    // và /download/android phục vụ từ đó về sau. Để trống: nút tải Android báo "chưa phát hành".
    "ANDROID_APK_URL": "https://expo.dev/artifacts/eas/tTovgoucFw-iYlkUziwWdr7pps31Z7wkQ2UUJGNezEA.apk",
    // Link tải cho iPhone: link TestFlight công khai (https://testflight.apple.com/join/...), lấy ở
    // App Store Connect → app WujoAgent → TestFlight → nhóm thử nghiệm bên ngoài → Public Link. Khi app đã
    // lên App Store thì đổi thành https://apps.apple.com/app/id6835067140.
    // Để trống: nút tải iPhone báo "chưa mở cho mọi người".
    "IOS_URL": ""
  },
  // Bucket riêng chứa file APK (android/wujoagent.apk). `npm run deploy` tự tạo nếu chưa có.
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "wujoagent-downloads" }],
  // Wrangler tự tạo bản ghi DNS và chứng chỉ cho tên miền khi deploy. Zone wujo.dev phải nằm trong
  // tài khoản Cloudflare đang đăng nhập.
  "routes": [{ "pattern": "agent.wujo.dev", "custom_domain": true }]
}
